diff --git a/node_modules/studiocms/frontend/pages/studiocms_api/[...all].ts b/node_modules/studiocms/frontend/pages/studiocms_api/[...all].ts
index 9035324..b6f2731 100644
--- a/node_modules/studiocms/frontend/pages/studiocms_api/[...all].ts
+++ b/node_modules/studiocms/frontend/pages/studiocms_api/[...all].ts
@@ -103,4 +103,27 @@ const APILive: Layer.Layer<Api, never, never> = config.features.api.apiDocs
 /**
  * Astro API Route - Converts the combined Effect API stack into an Astro route for serving the API documentation and endpoints.
  */
-export const ALL: APIRoute = HttpApiToAstroRoute(APILive);
+const apiHandler: APIRoute = HttpApiToAstroRoute(APILive);
+
+/**
+ * Effect's own HttpApi router matches endpoints (e.g. POST /studiocms_api/auth/login)
+ * against the request's raw URL, which still includes Astro's `base` prefix
+ * (e.g. /DG-studiocms/studiocms_api/auth/login) — Astro only strips `base` for
+ * its own page routing, not for the Request object handed to endpoint handlers.
+ * Without this, every request here fails to match any declared endpoint once a
+ * `base` is configured: GET falls through to the `router.get('*', ...)` catch-all
+ * and redirects to /404, but there's no equivalent wildcard for other methods,
+ * so e.g. POST logins get a bare unhandled 404 instead.
+ */
+export const ALL: APIRoute = async (context) => {
+	const base = import.meta.env.BASE_URL;
+	if (base && base !== '/') {
+		const url = new URL(context.request.url);
+		const prefix = base.endsWith('/') ? base.slice(0, -1) : base;
+		if (url.pathname.startsWith(prefix)) {
+			url.pathname = url.pathname.slice(prefix.length) || '/';
+			context.request = new Request(url, context.request);
+		}
+	}
+	return apiHandler(context);
+};

---
// This content type has no markdown/body content — all its data lives in the
// structured fields above. StudioCMS's page editor still requires a
// `page-content` field to exist in the form, so this stays hidden and empty.
---
<textarea id="page-content" name="page-content" hidden></textarea>

<script>
  // The edit page (EditPage.astro, core StudioCMS) only ever renders each
  // custom field's static `defaultValue` from its schema — it has no concept
  // of "the value already saved for this page" (that lives in our own
  // plugin_* tables, which core StudioCMS doesn't know about). Without this,
  // every reopen of the editor shows blank/default custom fields, making a
  // successful save look like it silently reverted. Fetch the real row and
  // populate the fields StudioCMS already rendered for us.
  const pageIdInput = document.querySelector<HTMLInputElement>('[name="page-id"]');
  const pageTypeSelect = document.querySelector<HTMLSelectElement>('[name="page-type"]');
  const fieldsContainer = document.getElementById('custom-page-type-fields');

  const pageId = pageIdInput?.value;
  const pageType = pageTypeSelect?.value;

  // The core "Page Title" field is shared by every content type in the
  // dashboard (blog posts, partners, videos, ...) and can't be relabeled
  // per-type through StudioCMS's plugin field config — it only controls the
  // "Custom Page Type Fields" section below it. For testimonials specifically,
  // that field holds the person's name, so relabel just this one instance
  // client-side rather than renaming it everywhere (which would be wrong for
  // every other content type).
  if (pageType === 'site-content/testimonial') {
    const titleLabelText = document.querySelector<HTMLElement>('label[for="page-title"] .label');
    if (titleLabelText) {
      const applyName = () => {
        const reqStar = titleLabelText.querySelector('.req-star');
        titleLabelText.textContent = 'Name ';
        if (reqStar) titleLabelText.appendChild(reqStar);
      };
      applyName();
      // core StudioCMS's own i18n store re-renders this same label text after
      // this script runs (its translation subscription resolves async), so a
      // one-shot write here gets clobbered back to "Page Title" a moment
      // later. Keep re-applying whenever that happens instead of racing it.
      new MutationObserver(() => {
        if (titleLabelText.textContent?.trim().startsWith('Name')) return;
        applyName();
      }).observe(titleLabelText, { childList: true, characterData: true, subtree: true });
    }
  }

  // Every image-path text field (avatar/logo/thumbnail, across all our
  // content types) gets an upload button + live thumbnail preview, instead
  // of editors having to know/type the exact /images/... path by hand.
  if (fieldsContainer) {
    for (const fieldName of ['avatar', 'logo', 'thumbnail']) {
      const input = fieldsContainer.querySelector<HTMLInputElement>(`[name="${fieldName}"]`);
      const label = input?.closest('label');
      if (!input || !label) continue;

      const wrapper = document.createElement('div');
      wrapper.style.cssText = 'display:flex;align-items:center;gap:12px;margin:8px 0 16px;';

      const preview = document.createElement('img');
      preview.style.cssText =
        'width:56px;height:56px;object-fit:cover;border-radius:6px;background:rgba(127,127,127,0.15);display:none;';
      preview.alt = '';
      const showPreview = (src: string) => {
        if (!src) {
          preview.style.display = 'none';
          return;
        }
        preview.src = src;
        preview.style.display = 'block';
      };
      preview.onerror = () => {
        preview.style.display = 'none';
      };

      const fileInput = document.createElement('input');
      fileInput.type = 'file';
      fileInput.accept = 'image/png,image/jpeg,image/webp,image/gif,image/svg+xml';
      fileInput.hidden = true;

      const uploadBtn = document.createElement('button');
      uploadBtn.type = 'button';
      uploadBtn.textContent = 'Upload image';
      uploadBtn.style.cssText =
        'padding:6px 12px;border-radius:6px;border:1px solid rgba(127,127,127,0.4);background:transparent;cursor:pointer;font-size:13px;';

      const status = document.createElement('span');
      status.style.cssText = 'font-size:12px;color:#a4a4a4;';

      uploadBtn.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;

        status.textContent = 'Uploading...';
        uploadBtn.disabled = true;

        try {
          const body = new FormData();
          body.append('file', file);
          const res = await fetch('/api/upload-image', { method: 'POST', body });
          const json = await res.json();

          if (!res.ok || !json.ok) {
            status.textContent = json.error || 'Upload failed';
            return;
          }

          input.value = json.path;
          showPreview(json.path);
          status.textContent = 'Uploaded';
          setTimeout(() => {
            status.textContent = '';
          }, 2000);
        } catch (err) {
          console.error('[site-content] image upload failed:', err);
          status.textContent = 'Upload failed';
        } finally {
          uploadBtn.disabled = false;
          fileInput.value = '';
        }
      });

      input.addEventListener('input', () => showPreview(input.value));
      showPreview(input.value);

      wrapper.append(preview, uploadBtn, fileInput, status);
      label.insertAdjacentElement('afterend', wrapper);
    }
  }

  if (pageId && pageType && fieldsContainer) {
    fetch(`/api/plugin-field-values?type=${encodeURIComponent(pageType)}&pageId=${encodeURIComponent(pageId)}`)
      .then((res) => (res.ok ? res.json() : null))
      .then((row: Record<string, unknown> | null) => {
        if (!row) return;
        for (const [key, value] of Object.entries(row)) {
          const el = fieldsContainer.querySelector<HTMLInputElement>(`[name="${key}"]`);
          if (!el) continue;
          if (el.type === 'checkbox') {
            // @studiocms/ui's checkbox draws its checkmark from a sibling
            // element's `aria-checked`, kept in sync only by a `change`
            // listener (see @studiocms/ui/dist/components/Checkbox/checkbox.js)
            // — setting `.checked` alone leaves the visual state stale.
            el.checked = value === 1 || value === true;
            el.dispatchEvent(new Event('change', { bubbles: true }));
          } else if (value !== null && value !== undefined) {
            el.value = String(value);
            // picked up by the image-preview `input` listener set up above,
            // so a loaded avatar/logo/thumbnail path shows its thumbnail too
            el.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
      })
      .catch((err) => console.error('[site-content] failed to load saved field values:', err));
  }
</script>

---
/**
 * src/pages/index.astro
 * ─────────────────────
 * Homepage. All dynamic content is backend-managed via the site-content
 * StudioCMS plugin (src/lib/content.ts queries plugin_* tables joined
 * against StudioCMSPageData) — editable from the dashboard, not JSON files.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnersCarousel from '../components/PartnersCarousel.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import { getPartners, getTestimonials, getYoutubeVideos, getSiteConfig } from '../lib/content';
import { withBase } from '../lib/withBase';

// ── Fetch dynamic content from StudioCMS-managed pages ─────────────────────
const partnersRaw  = await getPartners();
const testimonials = await getTestimonials();
const videos       = await getYoutubeVideos();

const partners = partnersRaw.filter((p) => p.active);
const featuredTestimonials = testimonials.filter((t) => t.featured);
const featuredVideos = videos.filter((v) => v.featured).slice(0, 3);

// "My Trusted Partners" home carousel reuses the existing Partner content
// type's logo images (getPartners() above) instead of a separate hardcoded
// list — getPartners() already applies withBase() to `logo`, so it's used
// as-is here. Falls back to the original static images only if no partner
// has a logo set yet, so the section never renders empty.
const partnerLogoImages = partners
  .filter((p) => p.logo)
  .map((p) => ({ src: p.logo as string, alt: p.name }));
const trustedPartnerImages = partnerLogoImages.length > 0
  ? partnerLogoImages
  : [
      { src: withBase('/images/img-justthrivehealth.webp'), alt: 'Protocol' },
      { src: withBase('/images/img-Auro-Wellness.webp'), alt: 'Podcast' },
      { src: withBase('/images/Stealth-apollo-front_SV.webp'), alt: 'Health & fitness' },
      { src: withBase('/images/timeline.webp'), alt: 'Health & fitness' },
      { src: withBase('/images/img-Jinfiniti.webp'), alt: 'Health & fitness' },
      { src: withBase('/images/img-Youngr-with-capsules.webp'), alt: 'Health & fitness' },
    ];

// ── Site config (StudioCMS dashboard singleton) ────────────────────────────
const site = await getSiteConfig();

// About Preview section: the heading highlights its last word in gold via a
// static <span> — kept working for any admin-entered title by splitting off
// the last word at render time rather than hardcoding which word is gold.
const aboutTitle = site.aboutTitle || 'The Wellness Revolutionary';
const aboutTitleWords = aboutTitle.trim().split(/\s+/);
const aboutTitleHighlight = aboutTitleWords.pop() || '';
const aboutTitleRest = aboutTitleWords.join(' ');

const aboutDescriptionDefault = `I am here to immerse you in the world of fitness and biohacking. Through the Dylan Gemelli Podcast, I engage with leading health and wellness experts, sharing insights that leverage the latest in fitness and longevity strategies.

My goal is simply stated: Provide EVERYONE the insight and guidance to obtain the highest quality of life! I am here to teach, motivate and inspire you all to be the best you can be in all aspects of health!

Dylan is a God first family man that is set on doing God's work, which for him, is helping everyone to not just add years to their lives, but life to their years!`;

// One textarea field covering all 3 paragraphs — blank-line-separated chunks
// become separate <p> tags (preserving the existing per-paragraph margin),
// and any remaining single line breaks within a chunk become <br/> (matching
// how podcastHeroSubtitle already preserves admin-entered line breaks).
const aboutParagraphs = (site.aboutDescription || aboutDescriptionDefault)
  .split(/\r\n\s*\r\n|\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// YouTube section heading highlights its last 2 words in gold (vs. the About
// heading's last 1) — same dynamic-split approach, sized to match this
// heading's existing design.
const youtubeSectionHeading = site.youtubeSectionHeading || 'Discover Videos That Matter';
const youtubeHeadingWords = youtubeSectionHeading.trim().split(/\s+/);
const youtubeHeadingHighlight = youtubeHeadingWords.splice(-2, 2).join(' ');
const youtubeHeadingRest = youtubeHeadingWords.join(' ');

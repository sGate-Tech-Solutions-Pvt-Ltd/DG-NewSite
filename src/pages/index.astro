<script>
  // Count-up animation for the stats section. Numbers are CMS-editable free
  // text (e.g. "500K+", "4.9"), so the target/prefix/suffix are parsed from
  // whatever text is already rendered rather than hard-coded.
  const DURATION = 1500;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animateCount(el: HTMLElement) {
    const raw = el.textContent?.trim() ?? '';
    const match = raw.match(/[\d,]*\.?\d+/);
    if (!match || match.index === undefined) return;

    const numStr = match[0];
    const target = parseFloat(numStr.replace(/,/g, ''));
    if (isNaN(target)) return;

    const prefix = raw.slice(0, match.index);
    const suffix = raw.slice(match.index + numStr.length);
    const useGrouping = numStr.includes(',');
    const decimals = numStr.includes('.') ? numStr.split('.')[1].length : 0;

    const start = performance.now();

    function tick(now: number) {
      const progress = Math.min((now - start) / DURATION, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = target * eased;

      const formatted = decimals
        ? current.toFixed(decimals)
        : useGrouping
          ? Math.round(current).toLocaleString('en-US')
          : String(Math.round(current));

      el.textContent = `${prefix}${formatted}${suffix}`;

      if (progress < 1) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  const statNums = document.querySelectorAll<HTMLElement>('.stat-num');

  if (reduceMotion) {
    // Leave the already-rendered values untouched.
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 }
    );

    statNums.forEach((el) => observer.observe(el));
  }
</script>

<style>
  /* ImageCarousel.astro's own CSS gives .imgCarousel-viewport no fixed
     height — it sizes to whatever image is currently showing, via each
     image's natural aspect ratio. That's fine for a fixed curated image
     set, but the "My Trusted Partners" carousel here now pulls live
     Partner `logo` uploads (see trustedPartnerImages above), whose shape
     an admin controls and can't be relied on to stay consistent. Pinning
     this to a square keeps the box's size stable regardless of what any
     future logo's dimensions are; :global() is required to reach into the
     child component's own (non-scoped-to-this-file) class names.
  */
  .trustedRight :global(.imgCarousel-viewport) {
    aspect-ratio: 1 / 1;
  }
</style>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dylan-gemelli-website",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "alias": {
    "pg": "./stubs/pg.js"
  },
  "hyperdrive": [
    // TODO: Replace "REPLACE_WITH_REAL_HYPERDRIVE_ID" with the real Hyperdrive config ID
    // from the Cloudflare dashboard (Workers & Pages > Hyperdrive) before deploying.
    { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_REAL_HYPERDRIVE_ID" }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dylan-gemelli-website",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "alias": {
    "pg": "./stubs/pg.js"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dylan-gemelli-website",
  // Wraps dist/_worker.js/index.js (Astro's generated handler) to also add
  // a scheduled() export for the warm-up cron below — fetch requests are
  // passed through to Astro's handler unchanged.
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Pings the homepage every 2 minutes so StudioCMS's SDK middleware cache
  // (verifyCache, ~3.6s of D1 queries on a cold isolate) stays warm for real
  // visitors instead of being paid by whoever hits a freshly spun-up
  // isolate. Only warms the isolate(s) Cloudflare runs this trigger from,
  // not every edge location — a partial mitigation, not a full fix.
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "alias": {
    "pg": "./stubs/pg.js"
  },
  // localConnectionString is a placeholder only: the pg client is stubbed
  // (see the "pg" alias above), so nothing actually connects through this
  // locally — it just satisfies wrangler dev's binding validation.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d4b911e814894dd3ba7466902b53c46b",
      "localConnectionString": "postgres://user:pass@localhost:5432/placeholder"
    }
  ],
  // Primary database as of the MySQL-to-D1 cutover (studiocms.config.mjs's
  // dialect and src/lib/db.ts's DB_DIALECT are both 'd1'). The Hyperdrive
  // binding above is kept live, untouched, as a rollback path for a window
  // after deploy — not deleted yet.
  "d1_databases": [
    { "binding": "DB", "database_name": "dylan-gemelli-db", "database_id": "250854c5-7888-4384-8aa9-5741e4c9af94" }
  ],
  // Uploaded content images (src/pages/api/upload-image.ts). Workers has no
  // writable filesystem, so these go to R2 instead of public/images/ and are
  // served back out at runtime by src/pages/images/[filename].ts.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "dylan-gemelli-images" }
  ],
  // Default Worker CPU limit is 50ms regardless of plan; the Workers Paid
  // plan's 30s/request allowance only applies once raised explicitly here.
  "limits": {
    "cpu_ms": 30000
  }
}


{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dylan-gemelli-website",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "alias": {
    "pg": "./stubs/pg.js"
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "d4b911e814894dd3ba7466902b53c46b" }
  ]
  // trigger redeploy: pick up Runtime section CMS_MYSQL_*/CMS_ENCRYPTION_KEY secrets
}

